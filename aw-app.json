{
  "manifest_version": 1,
  "id": "ux-proto",
  "name": "UX-Proto",
  "version": "0.6.0",
  "description": "Agent-piloted visual prototyping \u2014 write real HTML/CSS/JS + a mock Python backend per project, with live hot-reload, driven entirely via MCP tools.",
  "icon": "layout-template",
  "tier": "container",
  "requires_ui_refresh": true,
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "medium",
    "memory": "~1 GB",
    "disk": "~1.5 GB"
  },
  "runtime": {
    "image": "ghcr.io/tekflox/aw-app-ux-proto:latest",
    "port": 10021,
    "resources": {
      "cpus": 1,
      "mem_mb": 2048
    },
    "env": {
      "PGDATA": "/data/pgdata"
    },
    "volumes": [
      {
        "source": "$AW_APP_DATA",
        "target": "/data",
        "mode": "rw"
      }
    ]
  },
  "permissions": [
    "containers:manage",
    "net:outbound",
    "fs:workspace-data"
  ],
  "contributes": {
    "windows": [
      {
        "id": "ux-proto.main",
        "title": "UX-Proto",
        "icon": "layout-template",
        "body": {
          "type": "managed_app",
          "kind": "iframe",
          "path": "/"
        }
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "auto_start": {
        "type": "boolean",
        "default": true,
        "title": "Auto-start",
        "description": "Start this app automatically when the workspace starts."
      }
    },
    "required": []
  }
}
